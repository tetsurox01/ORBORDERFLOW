# Copy to .env and fill in. .env is gitignored and must NEVER be committed --
# this repo is PUBLIC. A committed key is a published key: git history keeps it
# after deletion, so the only real fix is rotating it at the vendor.
#
# IVB_CONFIRM_SPEND is deliberately NOT listed here. It is a per-run purchase
# decision, not configuration, and no file is allowed to pre-authorise a spend.
# Set it in the environment for one command only:
#     $env:IVB_CONFIRM_SPEND = 'yes'; python scripts/01_download.py ...

DATABENTO_API_KEY=
